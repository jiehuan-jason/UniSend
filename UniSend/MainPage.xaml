<Page
    x:Class="UniSend.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:UniSend.Models"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- 顶部操作栏 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="UniSend - LocalSend UWP" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtStatus" Text="正在启动..." VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="刷新/重新广播" Click="OnBroadcastClick" Margin="0,0,16,0"/>
                <Button Content="打开下载目录" Click="OnOpenFolderClick"/>
            </StackPanel>
        </StackPanel>

        <!-- 中部：已发现设备列表 -->
        <Grid Grid.Row="1" Margin="0,16,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="已发现的设备 (局域网):" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <ListView Grid.Row="1" x:Name="DeviceListView" BorderThickness="1" BorderBrush="Gray">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DeviceDto">
                        <StackPanel Padding="8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="📱" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Bind Alias}" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Bind DeviceModel}" Foreground="Gray"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind DisplayText}" FontSize="12" Foreground="DarkGray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 底部：日志控制台 -->
        <ScrollViewer Grid.Row="2" BorderThickness="1" BorderBrush="LightGray" Padding="6">
            <TextBlock x:Name="TxtLogs" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
        </ScrollViewer>
    </Grid>
</Page>